# ================================
# Smart Agent System - Environment Configuration Template
# ================================
# Copy this file to .env and fill in your API keys

# ================================
# API Keys Configuration
# ================================

# DeepSeek API (recommended - much cheaper, ~$0.10/1M tokens)
# Get your key at: https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here

# OpenAI API (required for Browser Use agent)
# Get your key at: https://platform.openai.com  
OPENAI_API_KEY=sk-your-openai-api-key-here

# Anthropic Claude API (optional - for advanced reasoning)
# Get your key at: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-claude-key-here

# ================================
# Reasoning Engine Selection
# ================================

# Choose your primary reasoning engine: "deepseek" | "openai" | "claude"
# deepseek = Most cost-effective ($0.10/1M tokens)
# openai = Best compatibility and performance  
# claude = Advanced reasoning capabilities
REASONING_ENGINE=deepseek

# ================================
# Browser Use Configuration
# ================================

# LLM model for Browser Use agent (uses OpenAI)
BROWSER_LLM_MODEL=gpt-4o-mini
# Alternative models: gpt-4, gpt-4-turbo, claude-3-5-sonnet-20241022

# Browser automation settings
HEADLESS_BROWSER=false
BROWSER_TIMEOUT=30000
BROWSER_WINDOW_SIZE=1920x1080

# ================================
# Desktop Agent Configuration  
# ================================

# OCR language for UI text detection
OCR_LANGUAGE=eng

# UI detection mode for desktop automation
UI_DETECTION_MODE=windows

# Screenshot settings
SCREENSHOT_DIR=./screenshots
SCREENSHOT_QUALITY=95
AUTO_SCREENSHOT=true

# Desktop automation delays (milliseconds)
PYAUTOGUI_PAUSE=0.5
PYAUTOGUI_FAILSAFE=true

# ================================
# History Management Configuration
# ================================

# History storage settings
HISTORY_AUTO_SAVE=true
HISTORY_SAVE_INTERVAL=10
HISTORY_MAX_ENTRIES=1000
HISTORY_COMPRESSION=true

# AI summarization settings
HISTORY_SUMMARIZATION_THRESHOLD=20
HISTORY_CONTEXT_LENGTH=800
HISTORY_SUMMARY_LENGTH=400

# ================================
# Monitoring & Dashboard Configuration
# ================================

# Web dashboard settings (optional)
MONITOR_PORT=5050
MONITOR_USERNAME=admin
MONITOR_PASSWORD=your-secure-password

# Remote access via ngrok (optional)
ENABLE_NGROK=false
NGROK_AUTHTOKEN=your-ngrok-auth-token

# Performance monitoring
ENABLE_PERFORMANCE_METRICS=true
METRICS_COLLECTION_INTERVAL=60

# ================================
# Logging Configuration
# ================================

# Log levels: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
LOG_DIR=./logs

# Detailed logging options
ENABLE_DETAILED_LOGS=true
ENABLE_AGENT_LOGS=true
ENABLE_HISTORY_LOGS=false
LOG_ROTATION=true
MAX_LOG_SIZE=10MB

# ================================
# Security & Privacy Configuration
# ================================

# Data retention (days)
SESSION_RETENTION_DAYS=30
LOG_RETENTION_DAYS=7

# Privacy settings
ANONYMIZE_LOGS=false
ENCRYPT_SESSION_DATA=false

# Rate limiting
API_RATE_LIMIT_PER_MINUTE=60
BROWSER_REQUEST_DELAY=1.0

# ================================
# Advanced Configuration
# ================================

# Concurrent execution limits
MAX_CONCURRENT_BROWSER_SESSIONS=3
MAX_CONCURRENT_DESKTOP_TASKS=1

# Timeout settings (seconds)
TASK_EXECUTION_TIMEOUT=300
AGENT_RESPONSE_TIMEOUT=60
API_REQUEST_TIMEOUT=30

# Memory management
HISTORY_MEMORY_LIMIT=100MB
SCREENSHOT_CACHE_SIZE=50
AUTO_CLEANUP_TEMP_FILES=true

# Development settings
DEBUG_MODE=false
ENABLE_TELEMETRY=true
SKIP_SAFETY_CHECKS=false

# ================================
# Optional Integrations
# ================================

# Email notifications (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Database connection (optional - uses SQLite by default)
DATABASE_URL=sqlite:///./smart_agent.db
# DATABASE_URL=postgresql://user:pass@localhost/smart_agent

# Cloud storage (optional)
# AWS_ACCESS_KEY_ID=your-aws-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret
# S3_BUCKET_NAME=smart-agent-data

# ================================
# Environment-Specific Overrides
# ================================

# Override settings for different environments
# Uncomment the section that matches your environment

# # Development Environment
# LOG_LEVEL=DEBUG
# HEADLESS_BROWSER=false
# ENABLE_DETAILED_LOGS=true

# # Production Environment  
# LOG_LEVEL=WARNING
# HEADLESS_BROWSER=true
# ENABLE_DETAILED_LOGS=false
# ENABLE_PERFORMANCE_METRICS=true

# # Testing Environment
# LOG_LEVEL=INFO
# BROWSER_TIMEOUT=10000
# TASK_EXECUTION_TIMEOUT=60
